<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Download Model"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:marginBottom="16dp" />

    <!-- Instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paste a HuggingFace GGUF model URL below and tap Download.\n\nRecommended models:\n• Mistral-7B-Q4_K_M (~4GB, fast)\n• Phi-2 (~2GB, very fast)\n• Llama-2-7B-Q4 (~4GB, balanced)"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:marginBottom="16dp"
        android:lineSpacingMultiplier="1.3" />

    <!-- URL Input -->
    <EditText
        android:id="@+id/huggingface_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste HuggingFace URL here..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:padding="12dp"
        android:background="@drawable/edit_text_background"
        android:inputType="textUri"
        android:lines="3"
        android:gravity="top"
        android:marginBottom="16dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:visibility="gone"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:marginBottom="8dp" />

    <!-- Progress Text -->
    <TextView
        android:id="@+id/progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:marginBottom="16dp" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to download"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:padding="12dp"
        android:background="@drawable/status_background"
        android:marginBottom="16dp" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="8dp">

        <Button
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back"
            android:background="@color/surface"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/download_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Download"
            android:background="@color/primary"
            android:textColor="@color/white"
            android:marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
